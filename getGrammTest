import zipfile
import xml.etree.ElementTree as ET
from decimal import Decimal


def get_total_weight_from_gcode_3mf(path: str) -> float:
    with zipfile.ZipFile(path, "r") as zf:
        with zf.open("Metadata/slice_info.config") as f:
            xml_data = f.read()

    root = ET.fromstring(xml_data)

    total_g = Decimal("0")

    # Ищем все теги filament в документе
    for filament in root.iter("filament"):
        used_g = filament.attrib.get("used_g")
        if used_g:
            total_g += Decimal(used_g)

    return float(total_g)


